# Huginn reverse proxy.
#
# TLS here uses a locally generated self-signed certificate pair mounted from
# ./certs/ (huginn.crt + huginn.key, issued by the "Huginn Local CA" whose root
# is huginn-ca.crt). SANs cover every address of this host (Netbird IP, LAN IP,
# public IP, localhost). Clients only need to trust huginn-ca.crt — served at
# /caddy-root.crt so the worker installer can bootstrap trust automatically.
# To switch to trusted Let's Encrypt certs instead, replace the `tls` block
# below with `tls <your-email>` and point HUGINN_DOMAIN at a real public domain.

# Clients connecting by IP literal send no SNI; treat such connections as the
# configured host so the right certificate is served.
{
	default_sni {$HUGINN_DOMAIN}
}

{$HUGINN_DOMAIN}, localhost, :443 {
	# Locally generated cert (see ./certs/ and the header comment above).
	tls /etc/caddy/certs/huginn.crt /etc/caddy/certs/huginn.key
	encode gzip

	# Security headers on every response.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}

	# Hub REST API + health.
	handle /api/* {
		reverse_proxy hub:8000 {
			# Trust container-internal proxy hops (docker/podman bridges, loopback)
			# so the real client IP survives local tunnels in X-Forwarded-For.
			# Direct connections keep their real source — only local proxy
			# ranges are trusted. Adjust to your container runtime's ranges.
			trusted_proxies 10.88.0.0/16 10.89.0.0/16 127.0.0.0/8 172.16.0.0/12
			# Stamp the real client IP + scheme into headers the client cannot
			# forge (overwrites any client-supplied value, like the /mcp* block
			# below). The hub's trust_forwarded_for then reads the proxy-written
			# value — never a client-controlled list entry.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /healthz {
		reverse_proxy hub:8000
	}
	# Prometheus scrape endpoint — not exposed on the public hostname (that is
	# the externally reachable entry point), only on direct hosts (LAN/VPN IP,
	# localhost). A local CDN tunnel cannot be distinguished by source IP, so
	# the public hostname is what we gate on.
	@metrics_public {
		path /metrics
		host {$HUGINN_DOMAIN}
	}
	handle @metrics_public {
		respond 403
	}
	handle /metrics {
		reverse_proxy hub:8000
	}

	# MCP server (streamable HTTP).
	handle /mcp* {
		reverse_proxy mcp:9000 {
			trusted_proxies 10.88.0.0/16 10.89.0.0/16 127.0.0.0/8 172.16.0.0/12
			# Stamp the real client IP into a header the client cannot forge
			# (overwrites any client-supplied value). The MCP server trusts
			# this for per-token IP allow-lists.
			header_up X-Real-IP {remote_host}
		}
	}

	# Self-hosted worker artifacts (served from mounted files), so the install
	# one-liner works without depending on GitHub releases.
	handle /install.sh {
		root * /srv
		file_server
	}
	handle /dist/* {
		root * /srv
		file_server
	}
	# Huginn Local CA root (the public certificate, not the key) for trust
	# bootstrap by the worker installer.
	handle /caddy-root.crt {
		root * /etc/caddy/certs
		rewrite * /huginn-ca.crt
		file_server
	}

	# Everything else: the dashboard SPA.
	handle {
		reverse_proxy dashboard:80
	}
}
